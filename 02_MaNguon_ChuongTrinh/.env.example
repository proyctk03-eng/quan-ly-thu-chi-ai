# ------------------------------------------------------------------------------
# FILE CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (ENVIRONMENT VARIABLES TEMPLATE)
# ------------------------------------------------------------------------------
# Hãy copy file này thành file ".env" trong cùng thư mục và điền API Key của bạn.
#
# Cách lấy Google Gemini API Key:
# 1. Truy cập https://aistudio.google.com/
# 2. Đăng nhập bằng tài khoản Google.
# 3. Click "Create API Key" (Tạo API Key).
# 4. Sao chép API Key và dán vào bên dưới (không dùng dấu nháy).
# ------------------------------------------------------------------------------

GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# CẤU HÌNH PROXY (TÙY CHỌN - Dùng khi bị chặn địa lý Geo-blocking)
# ------------------------------------------------------------------------------
# Nếu bạn gặp lỗi "User location is not supported for the API use",
# hãy bỏ comment và điền địa chỉ proxy của bạn bên dưới.
# Proxy sẽ được tự động inject vào os.environ trước mỗi lần gọi API.
#
# HTTP_PROXY=http://your-proxy-address:port
# HTTPS_PROXY=http://your-proxy-address:port
